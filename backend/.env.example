# Copy to backend/.env and fill in. Never commit the real .env.

# Kindroid → Settings → General → API & advanced integrations
KINDROID_API_KEY=
# Group chat to post into, and the kin that replies
KINDROID_GROUP_ID=
KINDROID_AI_ID=
# Group chat the daily mantras are requested in
KINDROID_MANTRA_GROUP_ID=

# Password you enter in the app to unlock it
APP_PASSWORD=

# Where data.json (mantras, counters, schedule) is kept. On Railway: the volume mount path, e.g. /data
DATA_DIR=

# Push notifications. Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
